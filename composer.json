{
    "name": "voicechat/soulchill-clone",
    "type": "project",
    "description": "Professional voice chat platform built with PHP 8.3 MVC",
    "keywords": ["voice-chat", "webrtc", "social", "mvc", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "VoiceChat Team",
            "email": "team@voicechat.local"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "firebase/php-jwt": "^6.10",
        "phpmailer/phpmailer": "^6.9",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "intervention/image": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "start": "php -S 0.0.0.0:8000 -t public",
        "ws": "php public/ws.php",
        "test": "phpunit"
    }
}
